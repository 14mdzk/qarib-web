# Test environment variables for vitest and svelte-check.
# Safe to commit — contains no real secrets.
#
# SvelteKit reads this file when NODE_ENV=test, giving svelte-check and
# vitest access to the $env/static/* virtual modules with the correct exports.

# Public
PUBLIC_API_URL=/api/upstream
PUBLIC_LOG_LEVEL=info
PUBLIC_APP_NAME=Qarib

# Private
UPSTREAM_API_URL=https://test-upstream.example.com
STADIA_API_KEY=test-stadia-key
NODE_ENV=test
