---
import { getMessages } from '../lib/i18n';

const m = getMessages('id');
---

<section id="atas" class="bg-surface relative overflow-hidden">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute -top-32 right-[-10%] h-96 w-96 rounded-full bg-paper-3 blur-3xl"></div>
		<div class="absolute bottom-[-40%] left-[-5%] h-72 w-72 rounded-full bg-surface-2 blur-3xl"></div>
	</div>
	<div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-24">
		<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-6">
			<div class="anim-hero-rise max-w-xl">
				<h1 class="text-content text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl">
					<span class="text-primary font-serif italic">{m.hero_kajian}</span>
					<br />
					{m.hero_headline}
				</h1>
				<p class="text-content-2 mt-6 text-lg leading-relaxed sm:text-xl">{m.hero_lede}</p>
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a
						href="#unduh"
						class="bg-primary hover:bg-primary-hover rounded-full px-6 py-3 text-base font-semibold text-white transition-colors"
					>
						{m.cta_primary}
					</a>
					<a
						href="#cara-kerja"
						class="border-border text-content hover:border-content-4 rounded-full border px-6 py-3 text-base font-semibold transition-colors"
					>
						{m.cta_secondary}
					</a>
				</div>
			</div>
			<div class="anim-hero-float mx-auto w-full max-w-md lg:max-w-none">
				<img
					src="/hero-map.png"
					alt="Ilustrasi peta menuju masjid terdekat"
					width="1024"
					height="1024"
					class="h-auto w-full"
					loading="eager"
				/>
			</div>
		</div>
	</div>
</section>
