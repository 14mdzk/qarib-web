---
import { getMessages } from '../lib/i18n';

const m = getMessages('id');
---

<section id="atas" class="bg-surface relative overflow-hidden">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute -top-32 right-[-10%] h-96 w-96 rounded-full bg-paper-3 blur-3xl"></div>
		<div class="absolute bottom-[-40%] left-[-5%] h-72 w-72 rounded-full bg-surface-2 blur-3xl"></div>
	</div>
	<div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-24">
		<div class="max-w-xl">
			<img
				src="/tile.png"
				alt="Logo Qarib"
				width="72"
				height="72"
				class="rounded-xl shadow-lg"
			/>
			<p class="font-arabic text-content-3 mt-6 text-2xl">{m.app_title_ar}</p>
			<p class="text-primary mt-3 flex items-center gap-2 text-xs font-bold tracking-[0.15em] uppercase">
				<span class="bg-accent inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
				{m.eyebrow}
			</p>
			<h1 class="text-content mt-4 text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl">
				<span class="text-primary font-serif italic">{m.hero_kajian}</span>
				<br />
				{m.hero_headline}
			</h1>
			<p class="text-content-2 mt-6 text-lg leading-relaxed sm:text-xl">{m.hero_lede}</p>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a
					href="#unduh"
					class="bg-primary rounded-full px-6 py-3 text-base font-semibold text-white"
				>
					{m.cta_primary}
				</a>
				<a
					href="#cara-kerja"
					class="border-border text-content rounded-full border px-6 py-3 text-base font-semibold"
				>
					{m.cta_secondary}
				</a>
			</div>
		</div>
	</div>
</section>
