---
import MobileMenu from './MobileMenu.svelte';
import { getMessages } from '../lib/i18n';

const m = getMessages('id');
const links = [
	{ href: '#cara-kerja', label: m.nav_how },
	{ href: '#fitur', label: m.nav_features }
];
---

<header class="bg-surface/90 sticky top-0 z-50 border-b border-border backdrop-blur">
	<div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
		<a href="#atas" class="flex items-center gap-2.5">
			<img src="/tile.png" alt="Qarib" width="32" height="32" class="rounded-lg" />
			<span class="text-content text-lg font-bold tracking-tight">{m.app_title}</span>
		</a>
		<nav class="hidden items-center gap-7 sm:flex" aria-label="Navigasi">
			{links.map((link) => (
				<a href={link.href} class="text-content-2 text-base font-medium">
					{link.label}
				</a>
			))}
			<a
				href="#unduh"
				class="bg-primary rounded-full px-5 py-2.5 text-base font-semibold text-white"
			>
				{m.nav_get_app}
			</a>
		</nav>
		<MobileMenu
			client:load
			openLabel={m.nav_menu_open}
			closeLabel={m.nav_menu_close}
			links={links}
			ctaLabel={m.nav_get_app}
			ctaHref="#unduh"
		/>
	</div>
</header>
