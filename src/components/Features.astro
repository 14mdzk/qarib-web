---
import { getCollection, render } from 'astro:content';
import { getMessages } from '../lib/i18n';

const m = getMessages('id');
const features = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(features.map(async (feature) => ({ feature, Content: (await render(feature)).Content })));
---

<section id="fitur" class="bg-surface scroll-mt-16 px-6 py-20 sm:py-24">
	<div class="mx-auto max-w-4xl">
		<p class="text-primary text-xs font-bold tracking-[0.15em] uppercase">{m.features_eyebrow}</p>
		<h2 class="text-content mt-4 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
			{m.features_title_pre}
			<span class="text-primary font-serif italic">{m.features_title_em}</span>{m.features_title_post}
		</h2>
		<p class="text-content mt-6 font-serif text-xl italic sm:text-2xl">{m.features_lead}</p>
		<ol class="mt-10">
			{rendered.map(({ feature, Content }, i) => (
				<li class="border-border grid gap-2 border-t py-8 sm:grid-cols-[4rem_1fr] sm:gap-6">
					<span class="text-content-4 font-serif text-2xl italic" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<div>
						<h3 class="text-content text-xl font-bold">{feature.data.title}</h3>
						<div class="text-content-2 mt-2 max-w-2xl text-lg leading-relaxed">
							<Content />
						</div>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>
